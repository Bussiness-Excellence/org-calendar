{
  "expo": {
    "name": "Org Calendar",
    "slug": "org-calendar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orgcalendar",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0B4D89",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bussinessexcellence.orgcalendar"
    },
    "android": {
      "package": "com.bussinessexcellence.orgcalendar",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B4D89"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "single",
      "name": "Org Calendar: Organization departments and sections",
      "shortName": "Org Calendar",
      "themeColor": "#0B4D89",
      "backgroundColor": "#EEF2F6"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to use as your organization's logo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B4D89"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/org-calendar"
    }
  }
}
